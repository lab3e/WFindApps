#include "resource.h"

#define APSTUDIO_READONLY_SYMBOLS
#include "winres.h"
#include "afxres.h"
#undef APSTUDIO_READONLY_SYMBOLS

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDR_MAINFRAME           ICON                    "res\\WCopyfind.ico"

/////////////////////////////////////////////////////////////////////////////
// Main dialog

IDD_WCOPYFIND_DIALOG DIALOGEX 0, 0, 452, 358
STYLE DS_SETFONT | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_APPWINDOW | WS_EX_ACCEPTFILES
CAPTION "WCopyfind"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "1   Choose the documents",IDC_STATIC_STEP1,10,7,300,11
    LTEXT           "New documents: compared with each other and with the old documents",IDC_STATIC_NEW,10,20,350,9
    RTEXT           "",IDC_STATIC_NEW_COUNT,366,20,78,9
    CONTROL         "",IDC_LIST_NEW,"SysListView32",LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,10,31,348,58
    CONTROL         "&Add Documents...",IDC_BUTTON_ADD_NEW,"Button",BS_SPLITBUTTON | WS_TABSTOP,366,31,78,14
    PUSHBUTTON      "&Remove",IDC_BUTTON_REMOVE_NEW,366,48,78,14
    LTEXT           "Old documents: compared only with the new documents (for example, earlier papers or sources)",IDC_STATIC_OLD,10,95,350,9
    RTEXT           "",IDC_STATIC_OLD_COUNT,366,95,78,9
    CONTROL         "",IDC_LIST_OLD,"SysListView32",LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,10,106,348,44
    CONTROL         "Add D&ocuments...",IDC_BUTTON_ADD_OLD,"Button",BS_SPLITBUTTON | WS_TABSTOP,366,106,78,14
    PUSHBUTTON      "R&emove",IDC_BUTTON_REMOVE_OLD,366,123,78,14
    LTEXT           "Drag documents or folders onto a list. Click the arrow beside Add Documents, or right-click a list, to load, save, sort, or clear it.",IDC_STATIC_HINT1,10,155,434,9

    LTEXT           "2   Decide what counts as a match",IDC_STATIC_STEP2,10,171,300,11
    LTEXT           "Match phrases of at least",IDC_STATIC_PHRASE1,10,186,86,9
    EDITTEXT        IDC_EDIT_PHRASE,97,184,30,12,ES_RIGHT | ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "",IDC_SPIN_PHRASE,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,127,184,10,12
    LTEXT           "words",IDC_STATIC_PHRASE2,131,186,24,9
    LTEXT           "Report pairs that share at least",IDC_STATIC_THRESHOLD1,176,186,106,9
    EDITTEXT        IDC_EDIT_THRESHOLD,283,184,34,12,ES_RIGHT | ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "",IDC_SPIN_THRESHOLD,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,317,184,10,12
    LTEXT           "matching words",IDC_STATIC_THRESHOLD2,321,186,60,9
    LTEXT           "Allow up to",IDC_STATIC_TOLERANCE1,10,201,40,9
    EDITTEXT        IDC_EDIT_TOLERANCE,51,199,26,12,ES_RIGHT | ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "",IDC_SPIN_TOLERANCE,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,77,199,10,12
    LTEXT           "imperfect words in a row",IDC_STATIC_TOLERANCE2,81,201,100,9
    CONTROL         "Ignore letter &case",IDC_CHECK_IGNORE_CASE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,216,78,10
    CONTROL         "Ignore p&unctuation",IDC_CHECK_IGNORE_PUNCTUATION,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,96,216,82,10
    CONTROL         "Ignore &numbers",IDC_CHECK_IGNORE_NUMBERS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,186,216,70,10
    PUSHBUTTON      "More O&ptions...",IDC_BUTTON_OPTIONS,366,213,78,14

    LTEXT           "3   Compare",IDC_STATIC_STEP3,10,234,300,11
    DEFPUSHBUTTON   "Co&mpare Documents",IDC_BUTTON_COMPARE,10,247,96,20
    LTEXT           "",IDC_STATIC_STATUS,114,249,330,9,SS_ENDELLIPSIS
    CONTROL         "",IDC_PROGRESS,"msctls_progress32",NOT WS_VISIBLE,114,260,330,6
    CONTROL         "",IDC_LIST_REPORT,"SysListView32",LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,10,273,434,64
    LTEXT           "Double-click a pair to see the two documents side by side. Click a column heading to sort.",IDC_STATIC_HINT3,10,343,350,9
    PUSHBUTTON      "Open Re&port",IDC_BUTTON_REPORT,366,340,78,14
END

/////////////////////////////////////////////////////////////////////////////
// More Options dialog

IDD_OPTIONS DIALOGEX 0, 0, 300, 272
STYLE DS_SETFONT | DS_FIXEDSYS | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "More Options"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Matching",IDC_STATIC,8,6,284,112
    LTEXT           "When a phrase has imperfect words, at least",IDC_STATIC,16,21,150,9
    EDITTEXT        IDC_EDIT_PERCENTAGE,167,19,30,12,ES_RIGHT | ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "",IDC_SPIN_PERCENTAGE,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,197,19,10,12
    LTEXT           "% of its words must match",IDC_STATIC,201,21,88,9
    CONTROL         "Ignore punctuation only at the start and end of words (used when ""Ignore punctuation"" is off)",IDC_CHECK_OUTER_PUNCTUATION,"Button",BS_AUTOCHECKBOX | BS_MULTILINE | WS_TABSTOP,16,37,270,18
    CONTROL         "Skip words that contain digits or symbols",IDC_CHECK_SKIP_NONWORDS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,58,200,10
    CONTROL         "Skip words longer than",IDC_CHECK_SKIP_LONG,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,73,90,10
    EDITTEXT        IDC_EDIT_SKIP_LENGTH,107,71,30,12,ES_RIGHT | ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "",IDC_SPIN_SKIP_LENGTH,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,137,71,10,12
    LTEXT           "characters",IDC_STATIC,141,73,50,9
    CONTROL         "Basic characters only (discard words with accented or special characters)",IDC_CHECK_BASIC_CHARACTERS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,88,270,10
    LTEXT           "Language:",IDC_STATIC,16,103,40,9
    COMBOBOX        IDC_COMBO_LANGUAGE,58,101,110,200,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "Report",IDC_STATIC,8,124,284,80
    LTEXT           "Save reports in this folder:",IDC_STATIC,16,138,200,9
    EDITTEXT        IDC_EDIT_FOLDER,16,150,208,12,ES_AUTOHSCROLL
    PUSHBUTTON      "&Browse...",IDC_BUTTON_FOLDER,230,149,54,14
    CONTROL         "Brief report (show only the matching passages, for smaller files)",IDC_CHECK_BRIEF_REPORT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,170,260,10
    CONTROL         "&Open the report in my browser when the comparison finishes",IDC_CHECK_AUTO_OPEN,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,185,260,10

    GROUPBOX        "Tools",IDC_STATIC,8,210,284,34
    PUSHBUTTON      "Make &Vocabulary List...",IDC_BUTTON_VOCABULARY,16,223,96,14
    LTEXT           "Saves every word in the documents, with how often it appears.",IDC_STATIC,118,222,168,18

    PUSHBUTTON      "Restore All &Defaults",IDC_BUTTON_DEFAULTS,8,252,82,14
    DEFPUSHBUTTON   "OK",IDOK,188,252,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,242,252,50,14
END

