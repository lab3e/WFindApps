# BEGIN WFindApps redirects
# The Plagiarism Resource Site (plagiarism.bloomfieldmedia.com) has moved to WFindApps.org.
# Every page and post is sent permanently (301) to its new home, so old links and search
# rankings carry over. Real files (the old download zips, images) are still served, and
# WordPress's own login and admin pages are left alone.
# Goes at the top of the old site's .htaccess, above the "# BEGIN WordPress" block.
<IfModule mod_rewrite.c>
RewriteEngine On

# keep real files, and WordPress itself, working
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
RewriteRule ^(wp-admin|wp-content|wp-includes)(/|$) - [L]
RewriteRule ^wp-json(/|$) /index.php [L]
RewriteRule ^(wp-login\.php|xmlrpc\.php|wp-cron\.php)$ - [L]

# software pages
RewriteRule ^software/wcopyfind-instructions/?$ https://wcopyfind.wfindapps.org/guide.html [R=301,L]
RewriteRule ^software/interesting-things-wcopyfind-can-do/?$ https://wcopyfind.wfindapps.org/uses.html [R=301,L]
RewriteRule ^software/faq/?$ https://wcopyfind.wfindapps.org/faq.html [R=301,L]
RewriteRule ^software/wcopyfind/?$ https://wcopyfind.wfindapps.org/download.html [R=301,L]
RewriteRule ^software/copyfind/?$ https://wcopyfind.wfindapps.org/download.html#copyfind [R=301,NE,L]
RewriteRule ^software/to-do-list/?$ https://wcopyfind.wfindapps.org/changelog.html [R=301,L]
RewriteRule ^software/?$ https://wcopyfind.wfindapps.org/ [R=301,L]

# essays
RewriteRule ^2011/06/14/the-importance-of-writing/?$ https://wcopyfind.wfindapps.org/essays/the-importance-of-writing.html [R=301,L]
RewriteRule ^2011/06/14/on-stating-the-goals-for-assigned-work/?$ https://wcopyfind.wfindapps.org/essays/on-stating-the-goals-for-assigned-work.html [R=301,L]
RewriteRule ^2011/06/14/on-the-motivations-for-grade-inflation/?$ https://wcopyfind.wfindapps.org/essays/on-the-motivations-for-grade-inflation.html [R=301,L]
RewriteRule ^2011/06/14/on-the-motivations-for-cheating/?$ https://wcopyfind.wfindapps.org/essays/on-the-motivations-for-cheating.html [R=301,L]

# release announcements and site news
RewriteRule ^2014/06/20/initial-release-copyfind-4-1-2/?$ https://wcopyfind.wfindapps.org/download.html#copyfind [R=301,NE,L]
RewriteRule ^20[0-9][0-9]/[0-9][0-9]/[0-9][0-9]/new-release https://wcopyfind.wfindapps.org/changelog.html [R=301,L]
RewriteRule ^(20[0-9][0-9]/|latest-posts/?$|search-results/?$|feed/?$) https://wfindapps.org/news.html [R=301,L]

# site pages
RewriteRule ^links/?$ https://wcopyfind.wfindapps.org/about-plagiarism.html [R=301,L]
RewriteRule ^privacy-policy/?$ https://wfindapps.org/privacy.html [R=301,L]
RewriteRule ^(sample-page|copyright|terms-and-conditions)/?$ https://wfindapps.org/about.html [R=301,L]

# everything else, including the home page
RewriteRule ^ https://wcopyfind.wfindapps.org/? [R=301,L]
</IfModule>
# END WFindApps redirects

