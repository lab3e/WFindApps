    LTEXT           "WCopyfind",IDC_STATIC_VERSION,40,10,200,11,SS_NOPREFIX
    LTEXT           "Copyright (C) 2026 Louis A. Bloomfield",IDC_STATIC,40,23,200,9,SS_NOPREFIX
    CONTROL         "<a href=""https://WCopyfind.WFindApps.org"">WCopyfind.WFindApps.org</a>",IDC_LINK_WEB,"SysLink",WS_TABSTOP,40,35,200,9
    EDITTEXT        IDC_EDIT_ABOUT,10,52,280,120,ES_MULTILINE | ES_READONLY | WS_VSCROLL
    DEFPUSHBUTTON   "OK",IDOK,240,176,50,14,WS_GROUP
END

/////////////////////////////////////////////////////////////////////////////
// Menus

IDR_MENU_LIST MENU
BEGIN
    POPUP "List"
    BEGIN
        MENUITEM "&Add Documents...",           ID_LIST_ADD
        MENUITEM "Add a &Folder...",            ID_LIST_ADD_FOLDER
        MENUITEM SEPARATOR
        MENUITEM "&Load List from File...",     ID_LIST_LOAD
        MENUITEM "&Save List to File...",       ID_LIST_SAVE
        MENUITEM SEPARATOR
        MENUITEM "Sort by &Name",               ID_LIST_SORT
        MENUITEM "&Keep Sorted by Name",        ID_LIST_KEEP_SORTED
        MENUITEM SEPARATOR
        MENUITEM "&Move Selected to Old Documents", ID_LIST_MOVE
        MENUITEM "&Remove Selected",            ID_LIST_REMOVE
        MENUITEM "&Clear All",                  ID_LIST_CLEAR
    END
END

IDR_MENU_REPORT MENU
BEGIN
    POPUP "Report"
    BEGIN
        MENUITEM "&View Side by Side",          ID_REPORT_OPEN
        MENUITEM "Open the &Report",            ID_REPORT_INDEX
        MENUITEM SEPARATOR
        MENUITEM "&Save List to File...",       ID_REPORT_SAVE
        MENUITEM "&Remove Selected",            ID_REPORT_REMOVE
        MENUITEM "&Clear All",                  ID_REPORT_CLEAR
    END
END

